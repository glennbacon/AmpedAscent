{
  "name": "amped-ascent",
  "version": "2.0.0",
  "private": true,
  "description": "Amped Ascent — EV hill-climb driving game (three.js + Box2D remake)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tune": "vite-node tools/tune.ts"
  },
  "dependencies": {
    "planck": "1.4.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-node": "^2.1.9",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
